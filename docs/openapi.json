  "components": {
    "schemas": {
      "Clarify": {
        "properties": {
          "facts": {
            "$ref": "#/components/schemas/Facts"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facts",
          "idempotency_key"
        ],
        "title": "Clarify"
      },
      "CreateRun": {
        "properties": {
          "customer_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer Id"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "mode": {
            "type": "string",
            "pattern": "^(fixture|baseline|provider)$",
            "title": "Mode",
            "default": "fixture"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "facts": {
            "$ref": "#/components/schemas/Facts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_id",
          "message",
          "idempotency_key"
        ],
        "title": "CreateRun"
      },
      "Decision": {
        "properties": {
          "decision": {
            "type": "string",
            "pattern": "^(approve|reject)$",
            "title": "Decision"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "expected_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "expected_revision",
          "expected_hash"
        ],
        "title": "Decision"
      },
      "Facts": {
        "properties": {
          "order_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "damage_description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Damage Description"
          },
          "damage_reported_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Damage Reported At"
          },
          "photo_reviewed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Reviewed"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(refund|replacement|cancellation|escalation)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "amount_minor": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Minor"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Facts"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^(operator|supervisor|developer)$",
            "title": "Role"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "password"
        ],
        "title": "Login"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
